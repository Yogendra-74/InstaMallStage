<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="InstaMall iOS Suite" verbose="1">

    <listeners>
        <listener class-name="com.instamall.listeners.TestListener"/>
    </listeners>

    <!--
        The full order lifecycle, one phase per test method, run in
        series in lifecycle order (priority 1..6) and stopping at the
        first failure: Customer app places an order, the Shopper app
        accepts it through receipt submission, Delivery Solutions
        webhooks assign a driver and mark pickup, the Shopper app hands
        off, more webhooks carry it through to Delivered, and the
        Customer app confirms the order as Delivered. Runs first, against a clean
        simulator state. Any single phase can also be run on its own:
        mvn test -Dtest='Single_Order_Complete#phase2*'
    -->
    <test name="SingleOrderLifecycle">
        <classes>
            <class name="com.instamall.tests.model_02_rev.Single_Order_Complete"/>
        </classes>
    </test>

    <!--
        Shopper app only (installed on the same simulator) — each class
        starts its own session by bundle id, so it is unaffected by
        whatever the lifecycle above left in the foreground.
    -->
    <test name="ShopperLogin">
        <classes>
            <class name="com.instamall.tests.shopper.ShopperLoginTest"/>
        </classes>
    </test>

    <test name="OrderConfirmationAndApproval">
        <classes>
            <class name="com.instamall.tests.shopper.OrderConfirmationAndApprovalTest"/>
        </classes>
    </test>

</suite>
